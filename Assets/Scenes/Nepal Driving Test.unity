--- !u!114 &1487824443
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1487824442}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 209b603fd66f74d98b66b6d77435a0c3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LEDWallManager
  ledText: {fileID: 1487824444}
  timeBetweenQuotes: 3
  fadeSpeed: 1
  englishQuotes:
  - A driving license is not just a card; it is a commitment to safety.
  - Better late than never. Drive safe, arrive safe.
  - raffic rules are for your protection, not your restriction.
  - Mirrors, signals, and patience make a perfect driver.
  nepaliQuotes:
  - "\u0938\u0935\u093E\u0930\u0940 \u091A\u093E\u0932\u0915 \u0905\u0928\u0941\u092E\u0924\u093F\u092A\u0924\u094D\u0930
    \u0915\u0947\u0935\u0932 \u0915\u093E\u0930\u094D\u0921 \u0939\u094B\u0907\u0928,
    \u092F\u094B \u0938\u0941\u0930\u0915\u094D\u0937\u093E\u0915\u094B \u092A\u094D\u0930\u0924\u093F\u092C\u0926\u094D\u0927\u0924\u093E
    \u0939\u094B"
  - "\u0939\u0924\u093E\u0930 \u0917\u0930\u0947 \u092D\u0928\u094D\u0928 \u0938\u0915\u093F\u0928\u094D\u0928,
    \u092C\u093F\u0938\u094D\u0924\u093E\u0930\u0948 \u0917\u090F \u0905\u0935\u0936\u094D\u092F
    \u092A\u0941\u0917\u093F\u0928\u094D\u091B\u0964"
  - "\u091F\u094D\u0930\u093E\u092B\u093F\u0915 \u0928\u093F\u092F\u092E\u0915\u094B
    \u092A\u0942\u0930\u094D\u0923 \u092A\u093E\u0932\u0928\u093E \u0917\u0930\u094C\u0902,
    \u0906\u092B\u0942 \u0930 \u0905\u0930\u0941\u0932\u093E\u0908 \u0938\u0941\u0930\u0915\u094D\u0937\u093F\u0924
    \u0930\u093E\u0916\u094C\u0902\u0964"
  - "\u0910\u0928\u093E \u0939\u0947\u0930\u094C\u0902, \u0907\u0928\u094D\u0921\u093F\u0915\u0947\u091F\u0930
    \u092C\u093E\u0932\u094C\u0902, \u0930 \u0927\u0948\u0930\u094D\u092F\u0924\u093E\u0915\u093E
    \u0938\u093E\u0925 \u0917\u093E\u0921\u0940 \u091A\u0932\u093E\u0914\u0902\u0964"
